# SQLite file (relative to the server folder)
DATABASE_URL="file:./dev.db"
PORT=4000
# Where the React app runs (used for CORS)
CLIENT_ORIGIN="http://localhost:5173"
# "lax" when the client is served from the same site (dev proxy / reverse proxy).
# Use "none" (requires HTTPS) only if the frontend and API live on different sites.
COOKIE_SAMESITE="lax"
NODE_ENV="development"
